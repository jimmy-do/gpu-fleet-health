{
  "title": "GPU Fleet Health",
  "uid": "gpu-fleet-health",
  "tags": [
    "gpu",
    "dcgm",
    "nvidia"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "current": {},
        "hide": 0
      },
      {
        "name": "node",
        "type": "query",
        "label": "Node",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(DCGM_FI_DEV_GPU_TEMP, node)",
          "refId": "node"
        },
        "definition": "label_values(DCGM_FI_DEV_GPU_TEMP, node)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "GPU temperature",
      "description": "Alert threshold 83C (GPUTemperatureHigh).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 83
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            },
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "DCGM_FI_DEV_GPU_TEMP{node=~\"$node\"}",
          "legendFormat": "{{node}} GPU {{gpu}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "GPU utilization",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "off"
            },
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "DCGM_FI_DEV_GPU_UTIL{node=~\"$node\"}",
          "legendFormat": "{{node}} GPU {{gpu}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Memory used %",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            },
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * DCGM_FI_DEV_FB_USED{node=~\"$node\"} / (DCGM_FI_DEV_FB_USED{node=~\"$node\"} + DCGM_FI_DEV_FB_FREE{node=~\"$node\"})",
          "legendFormat": "{{node}} GPU {{gpu}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Power draw",
      "description": "RTX 4090 default power limit is 450W.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "off"
            },
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "DCGM_FI_DEV_POWER_USAGE{node=~\"$node\"}",
          "legendFormat": "{{node}} GPU {{gpu}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Last XID error (0 = none)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Value of the last XID reported by the driver. Any non-zero value fires GPUXidErrorReported; see README runbook.",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "DCGM_FI_DEV_XID_ERRORS{node=~\"$node\"}",
          "legendFormat": "{{node}} GPU {{gpu}}"
        }
      ]
    }
  ]
}
